# Copy to forever.env (same folder) and edit. Read by tools/sv_bridge.py,
# tools/patch_addons.py and tools/memwatch.sh. Real environment variables win
# over this file. Lines are KEY=VALUE; ~ is expanded.

# Path to the _classic_beta_ folder of your WoW: Forever install.
# Linux/Lutris example:
FOREVER_BETA_DIR=~/Games/battlenet/drive_c/Program Files (x86)/World of Warcraft/_classic_beta_
# Windows example:
#FOREVER_BETA_DIR=C:\Program Files (x86)\World of Warcraft\_classic_beta_

# Only needed if WTF/Account contains more than one <id>#<n> folder.
#FOREVER_ACCOUNT=123456789#1

# Force the polling watcher even when inotifywait exists (debugging).
#FOREVER_FORCE_POLL=1
